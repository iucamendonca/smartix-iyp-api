# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# Use id -u e id -g no Linux para conferir os IDs.
LOCAL_UID=1000
LOCAL_GID=1000
API_PORT=8000

# Recomendado: guardar os dados do Neo4j fora da pasta do repositório.
# Preencha com caminho ABSOLUTO para o diretório /data já restaurado.
# Sem esta variável, o Compose usa ./storage/data dentro do projeto.
# Exemplo (ajuste antes de usar):
# IYP_DATA_DIR=/home/usuario/Documents/SmartIX/iyp-dados/data
